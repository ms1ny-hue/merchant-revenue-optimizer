# Copy to .env and fill in your Plaid sandbox credentials.
# .env is git-ignored.

PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_sandbox_secret_here
PLAID_ENV=sandbox

# Optional: if you register a webhook URL in the Plaid dashboard, the
# link_token create function passes this through so Plaid delivers
# inbound webhooks to /.netlify/functions/plaid-webhook.
# PLAID_WEBHOOK_URL=https://your-site.netlify.app/.netlify/functions/plaid-webhook
