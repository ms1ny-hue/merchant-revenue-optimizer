{
  "name": "merchant-revenue-optimizer",
  "version": "1.0.0",
  "private": true,
  "description": "Commercial banking relationship economics prototype with live Plaid sandbox integration via Netlify Functions.",
  "scripts": {
    "dev": "netlify dev",
    "build:css": "tailwindcss -i src/tailwind.css -o dist/tailwind.css --minify",
    "build:js": "esbuild src/chart-bundle.js --bundle --minify --format=iife --outfile=dist/chart-bundle.js",
    "build": "npm run build:css && npm run build:js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chart.js": "^4.4.1",
    "plaid": "^27.0.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19"
  }
}
